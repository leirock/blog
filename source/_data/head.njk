{### 全站灰色滤镜 ###}
{% if config.gray_filter %}
  <style>
    html {
      filter: grayscale(85%) saturate(80%);
    }
    
    @media (prefers-color-scheme: light) {
      body {
        background-image: none;
        background: #d2d2d2;
      }
    }
  </style>
{% endif %}

{### Font Family ###}
<link rel="stylesheet" href="{{ config.cos_domain }}/fonts/longcang/LongCang-Regular.css" >
<link rel="stylesheet" href="{{ config.cos_domain }}/fonts/lxgw-wenkai-screen-webfont/lxgwwenkaigbscreen.css" >

