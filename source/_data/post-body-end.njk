{### 首行缩进 ###}
{% if post.indent %}
  <style>
    .post .post-body p {
      text-indent: 2em;
      margin-bottom: 0;
    }
    .post .post-body .image-caption,
    .post .post-body blockquote p {
      text-indent: 0;
      margin-bottom: 1em;
    }
    .post .post-body .note p {
      text-indent: 0;
    }
  </style>
{% endif %}


{### 相关推荐 ###}
{%- if post.tags %}
  {%- for tag in post.tags.toArray() %}
    {%- if tag.name == '文艺' %}
      <div class="arts-related">
        <h3 style="margin-bottom:-.3em"><i class="fas fa-guitar fa-fw"></i>相关推荐</h3>
        <ul>
          <li><a href="/tags/文艺/">文艺评论</a></li>
          <li><a href="/arts/">文艺清单</a></li>
        </ul>
      </div>
    {%- endif %}
  {%- endfor %}
{%- endif %}


{### 版权许可协议 ###}
{### 结构与文案统一由 scripts/inline-tags.js 的 license_box 维护，与 {% license %} 标签共用 ###}
{### 注：Hexo 会把 _data/*.njk 当数据文件再单独渲染一次，那里没有 helper，
    所以这里加存在性判断；NexT 注入时读的是文件原文，helper 可用 ###}
{%- if license_box -%}
{{ license_box({
  title: page.title,
  linkHref: page.permalink,
  linkText: page.permalink,
  authorLabel: '本文作者',
  authorName: post.orig_author or author,
  published: post.date and date(post.date) or '',
  updated: post.updated and date(post.updated) or '',
  origSrc: post.orig_src or '',
  origUrl: post.orig_url or '',
  ccLicense: post.cc_license or false,
  hasOrigAuthor: post.orig_author or false
}) }}
{%- endif -%}


{### 赞赏 ###}
{### 三类不开启赞赏：转载文章(orig_author: xxx)、通知公告(pid: 0)、手动设置不开启(donation: false) ###}
{%- if (not post.orig_author) and (post.pid > 0) and (post.donation != false) %}
  <div class="donation">
    <div class="donation-label">喜欢这篇文章？赞赏一下吧！</div>
    <a class="donation-button" href="/donation/">赞赏作者</a>
  </div>
{%- endif %}